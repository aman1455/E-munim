{
  "name": "e-munim",
  "version": "1.10.84",
  "description": "E-Munim — Smart, fast, and modern GST invoice & billing software for India. Tax Invoice, Proforma, Credit Note, Bill of Supply, Delivery Challan, GSTR-1 / GSTR-3B JSON exports, GSTR-2B reconciliation, e-Way Bill, TDS / TCS reports, multi-currency support, custom units, and offline-first data privacy.",
  "author": "DiceCodes <Contact@dicecodes.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aman1455/gst-billing-desktop.git"
  },
  "keywords": [
    "gst",
    "gst-invoice",
    "gst-billing-software",
    "free-billing-software",
    "invoice-generator",
    "tax-invoice",
    "billing-software-india",
    "gst-return",
    "gstr-1",
    "gstr-3b",
    "gstr-2b",
    "gstr-2b-reconciliation",
    "gstr-1-json-export",
    "gstr-3b-json-export",
    "tds",
    "tcs",
    "form-26q",
    "form-27eq",
    "section-194q",
    "section-206c",
    "e-way-bill",
    "delivery-challan",
    "credit-note",
    "proforma-invoice",
    "bill-of-supply",
    "pdf-generator",
    "offline-billing",
    "open-source",
    "vyapar-alternative",
    "tally-alternative",
    "zoho-alternative",
    "cleartax-alternative",
    "marg-erp-alternative",
    "mybillbook-alternative",
    "hsn-code",
    "sac-code",
    "uqc",
    "cgst-sgst-igst",
    "place-of-supply",
    "sez-invoice",
    "lut-export-invoice",
    "multi-currency-invoice",
    "international-invoice-india",
    "vat-invoice",
    "upi-qr-invoice",
    "pwa",
    "offline-pwa",
    "freelancer-invoice",
    "small-business-billing",
    "multi-business-profile",
    "multi-gstin",
    "rich-text-terms",
    "india-business-templates",
    "custom-units-invoice",
    "granular-backup",
    "google-drive-backup",
    "searchable-user-guide-pdf",
    "dark-mode-billing",
    "react",
    "vite",
    "expressjs",
    "india",
    "diceCodes"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "server": "node server.js",
    "postinstall": "node scripts/bundle-tesseract-assets.mjs",
    "prebuild": "node scripts/bundle-tesseract-assets.mjs",
    "dev": "node scripts/bundle-tesseract-assets.mjs && node server.js & vite",
    "dev:win": "node scripts/bundle-tesseract-assets.mjs && (start /b node server.js) && vite",
    "build": "vite build",
    "start": "vite build && node server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "bundle:tesseract": "node scripts/bundle-tesseract-assets.mjs",
    "release:zip": "npm run lint && npm run test:unit && npm run build && node scripts/build-release-zip.mjs && node scripts/verify-release.mjs",
    "test": "npm run test:unit && node tests/smoke.mjs",
    "test:unit": "node scripts/tax-test.mjs && node scripts/discount-modes-test.mjs && node scripts/csv-test.mjs && node scripts/manufacturing-test.mjs && node scripts/einvoice-test.mjs && node scripts/po-test.mjs && node scripts/errors-test.mjs && node scripts/costcentre-test.mjs && node scripts/businesstype-test.mjs && node scripts/cashbook-test.mjs && node scripts/purchase-payments-test.mjs && node scripts/hsnrates-test.mjs && node scripts/lut-tds-test.mjs && node scripts/fx-test.mjs && node scripts/services-test.mjs && node scripts/gstr1-json-test.mjs && node tests/licensing-test.mjs",
    "test:install": "playwright install firefox",
    "test:update-unix": "node scripts/test-update-unix.mjs",
    "test:fresh-linux": "node scripts/test-fresh-linux.mjs",
    "release:check": "node scripts/release-check.mjs",
    "docs:zip": "node scripts/build-docs-zip.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "electron:start": "npx electron .",
    "dist": "npm run build && npx electron-builder --win",
    "dist:dir": "npm run build && npx electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "electronVersion": "45.1.0",
    "appId": "com.dicecodes.freegstbilling",
    "productName": "Free GST Billing Software",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "licensing/**/*",
      "server.js",
      "src/utils.js",
      "release-templates/_system-scripts/app-icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "release-templates/_system-scripts/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Free GST Billing Software"
    }
  }
}